{
  "name": "@lightbox-gallery/element",
  "version": "0.1.0",
  "description": "Web Component (<lightbox-gallery>) for @lightbox-gallery/core — works in any framework or plain HTML via a script tag.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo \"covered by @lightbox-gallery/core\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "lightbox",
    "gallery",
    "image",
    "zoom",
    "carousel"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lightbox-gallery/core": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
