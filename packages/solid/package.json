{
  "name": "@lightbox-gallery/solid",
  "version": "0.1.0",
  "description": "SolidJS bindings for @lightbox-gallery/core — a modern lightbox gallery with zoom, swipe, thumbnails, slideshow and video support.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo \"covered by @lightbox-gallery/core\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "solid",
    "solidjs",
    "lightbox",
    "gallery",
    "image",
    "zoom",
    "carousel"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lightbox-gallery/core": "workspace:^"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
